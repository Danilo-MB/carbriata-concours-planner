    "@nestjs/platform-express": "^12.1.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.0.0",
    "express": "^5.2.1",
    "framer-motion": "^11.5.4",
    "leaflet": "^1.9.4",
    "lucide-react": "0.522.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
